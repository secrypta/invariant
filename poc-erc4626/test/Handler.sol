pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {IVault} from "../src/IVault.sol";
import {MockERC20} from "../src/MockERC20.sol";

/// @title Handler — the fuzzer's "steering wheel" (Handler/Actors pattern, docs/harness-patterns.md §2)
/// @notice GENERATED by invariant-gen from catalog/erc4626.md — do NOT edit by hand.
/// Meaningful actions with bounds + ghost variables to check the catalog invariants.
/// actors[0] is the attacker; the rest are victims. The fuzzer itself combines their deposits → the attack condition.
/// PROFIT ACCOUNTING (I2) is via CONSERVATION: wealth = token.balanceOf(atk) + previewRedeem(balanceOf(atk)),
/// profit = wealth − fundedAttacker. profit > 0 = value that flowed from the victims.
contract Handler is Test {
    IVault public vault;
    MockERC20 public token;
    address[] public actors;
    address public attacker;

    // tracked holders (for I3)
    address[] public holders;
    mapping(address => bool) internal seenHolder;

    // --- ghost variables ---
    uint256 public fundedAttacker;  // I2: total assets credited to the attacker (_fund + donate)
    int256 public maxProfitSeen = type(int256).min; // I2: max observed profit (wealth − funded)
    uint256 public maxSharePrice = 1; // RESULT number P: max assets per 1 wei of share over the run (floor ≥ 1)
    uint256 public maxRoundTripOvershoot; // I7: max (back - amt) in a round-trip
    bool public roundToZeroSeen;    // I1 (probe)
    bool public priceJumpSeen;      // I4 (probe)
    bool public maxWithdrawReverted;// I5
    bool public maxRedeemReverted;  // I5b
    bool public previewMismatch;    // I6

    uint256 internal constant DUST = 1;
    uint256 internal constant SMALL = 1e3;
    uint256 internal constant F = 1;       // I4: allowed share-price jump factor (no more than ×2)
    uint256 internal constant ONE = 1e18;  // "1 share" in terms of decimals=18
    uint256 internal constant CAP = 1e24;  // upper bound for amounts in bound()

    constructor(IVault v, MockERC20 t, address[] memory a) {
        vault = v;
        token = t;
        actors = a;
        attacker = a[0];
    }

    function holdersLength() external view returns (uint256) {
        return holders.length;
    }

    function _actor(uint256 seed) internal view returns (address) {
        return actors[bound(seed, 0, actors.length - 1)];
    }

    function _fund(address a, uint256 amount) internal {
        token.mint(a, amount);
        if (a == attacker) fundedAttacker += amount; // everything handed to the attacker
        vm.prank(a);
        token.approve(address(vault), type(uint256).max);
    }

    function _track(address a) internal {
        if (!seenHolder[a] && vault.balanceOf(a) > 0) {
            seenHolder[a] = true;
            holders.push(a);
        }
    }

    /// I2 proof (conservation): profit = (tokens in hand + redeemable from shares) − credited.
    function _recordProfit() internal {
        int256 wealth = int256(token.balanceOf(attacker) + vault.previewRedeem(vault.balanceOf(attacker)));
        int256 p = wealth - int256(fundedAttacker);
        if (p > maxProfitSeen) maxProfitSeen = p;
        if (vault.totalSupply() > 0) {
            uint256 sp = vault.convertToAssets(1);
            if (sp > maxSharePrice) maxSharePrice = sp;
        }
    }

    // --- actions ---

    function deposit(uint256 aSeed, uint256 amt) public {
        address a = _actor(aSeed);
        amt = bound(amt, DUST, CAP);
        uint256 pre = vault.previewDeposit(amt);
        _fund(a, amt);
        vm.prank(a);
        uint256 sh = vault.deposit(amt, a);
        // I1 (probe): a meaningful deposit must not yield 0 shares
        if (amt >= DUST && sh == 0) roundToZeroSeen = true;
        // I6: previewDeposit must not overstate the shares issued (not in the user's favor)
        if (pre > sh) previewMismatch = true;
        _track(a);
        _recordProfit();
    }

    function mint(uint256 aSeed, uint256 shares) public {
        address a = _actor(aSeed);
        shares = bound(shares, 1, CAP);
        uint256 assets = vault.previewMint(shares);
        if (assets == 0 || assets > CAP) return;
        _fund(a, assets);
        vm.prank(a);
        uint256 paid = vault.mint(shares, a);
        // I6: previewMint (taken BEFORE the operation) must not understate the required assets
        if (assets < paid) previewMismatch = true;
        _track(a);
        _recordProfit();
    }

    /// The attacker donates directly to the vault (bypassing deposit) — the core of the donation attack.
    function donate(uint256 amt) public {
        amt = bound(amt, 1, CAP);
        uint256 tsBefore = vault.totalSupply();
        uint256 priceBefore = tsBefore > 0 ? vault.convertToAssets(ONE) : 0;
        token.mint(attacker, amt);
        fundedAttacker += amt; // a donation is attacker-credited assets that he puts into the vault
        vm.prank(attacker);
        token.transfer(address(vault), amt);
        // I4 (probe): a share-price jump from a donation into a near-empty vault
        if (tsBefore > 0 && tsBefore <= SMALL) {
            uint256 priceAfter = vault.convertToAssets(ONE);
            if (priceAfter > priceBefore * (1 + F)) priceJumpSeen = true;
        }
        _recordProfit();
    }

    function withdraw(uint256 aSeed, uint256 amt) public {
        address a = _actor(aSeed);
        uint256 mw = vault.maxWithdraw(a);
        if (mw == 0) return;
        amt = bound(amt, 1, mw);
        vm.prank(a);
        vault.withdraw(amt, a, a);
        _track(a);
        _recordProfit();
    }

    function redeem(uint256 aSeed, uint256 shares) public {
        address a = _actor(aSeed);
        uint256 mr = vault.maxRedeem(a);
        if (mr == 0) return;
        shares = bound(shares, 1, mr);
        uint256 preR = vault.previewRedeem(shares);
        vm.prank(a);
        uint256 got = vault.redeem(shares, a, a);
        // I6: previewRedeem (taken BEFORE the operation) must not overstate the assets returned
        if (preR > got + 1) previewMismatch = true;
        _track(a);
        _recordProfit();
    }

    /// I5: withdrawing exactly maxWithdraw must not revert.
    function withdrawMax(uint256 aSeed) public {
        address a = _actor(aSeed);
        uint256 mw = vault.maxWithdraw(a);
        if (mw == 0) return;
        vm.prank(a);
        try vault.withdraw(mw, a, a) returns (uint256) {}
        catch {
            maxWithdrawReverted = true;
        }
        _track(a);
        _recordProfit();
    }

    /// I5b: redeeming exactly maxRedeem must not revert (max* consistent with the real operation).
    function redeemMax(uint256 aSeed) public {
        address a = _actor(aSeed);
        uint256 mr = vault.maxRedeem(a);
        if (mr == 0) return;
        vm.prank(a);
        try vault.redeem(mr, a, a) returns (uint256) {}
        catch {
            maxRedeemReverted = true;
        }
        _track(a);
        _recordProfit();
    }

    /// I7: a round-trip deposit→redeem must not return more than deposited (beyond rounding dust).
    function roundTrip(uint256 aSeed, uint256 amt) public {
        address a = _actor(aSeed);
        amt = bound(amt, DUST, CAP);
        _fund(a, amt);
        vm.prank(a);
        uint256 sh = vault.deposit(amt, a);
        if (sh == 0) {
            _track(a);
            _recordProfit();
            return;
        }
        vm.prank(a);
        uint256 back = vault.redeem(sh, a, a);
        if (back > amt && back - amt > maxRoundTripOvershoot) maxRoundTripOvershoot = back - amt;
        _track(a);
        _recordProfit();
    }
}
