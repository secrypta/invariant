pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {console2} from "forge-std/console2.sol";
import {IVault} from "../src/IVault.sol";
import {MockERC20} from "../src/MockERC20.sol";
import {Handler} from "./Handler.sol";

/// @title InvariantBase — cross-target invariants of the ERC-4626 catalog (catalog/erc4626.md)
/// @notice GENERATED by invariant-gen — do NOT edit by hand. ANSWER-AGNOSTIC: the generator does not know
/// whether the target is vuln or fix, and emits THE SAME set of assertions for ANY 4626 target. The verdict is given by the RUN.
/// Always asserted (identical for any target): gate I2 + controls I3,I5,I5b,I6 + detector I7.
/// Probes I1/I4 are OBSERVATIONAL: the ghost is written in Handler, values are logged in afterInvariant(),
/// but no assert is made (probes do NOT fail the suite). Target role (vuln/fix) comes from the run verdict, not from the emit.
abstract contract InvariantBase is Test {
    MockERC20 internal token;
    IVault internal vault;
    Handler internal handler;

    address internal constant ATTACKER = address(0xA11CE);
    address internal constant VICTIM1 = address(0xB0B);
    address internal constant VICTIM2 = address(0xCA201);

    // SLACK = 4·depth — the PROVEN floor of rounding noise (catalog §"Why SLACK = 4·depth").
    // Rounding moves the share price P = ta/ts only UP; per one foreign operation a holder receives < P.
    // Without yield P ≈ 1 ⇒ dust < 1 wei/op ⇒ < depth wei per run; ×4 is headroom. This is the NOISE LINE, NOT a theft
    // threshold: real attack profit is orders of magnitude larger. price-aware approach rejected (catalog §A6-SLACK).
    uint256 internal constant DEPTH = 64;        // = foundry.toml [invariant].depth
    uint256 internal constant SLACK = 4 * DEPTH; // = 256 at depth=64

    function _deployVault(MockERC20 asset_) internal virtual returns (IVault);

    function setUp() public {
        token = new MockERC20();
        vault = _deployVault(token);

        address[] memory actors = new address[](3);
        actors[0] = ATTACKER;
        actors[1] = VICTIM1;
        actors[2] = VICTIM2;

        handler = new Handler(vault, token, actors);
        targetContract(address(handler));
    }

    // ========= Gate: I2 (always asserted) =========

    /// I2 — the attacker gains no net profit beyond rounding dust (accounting via CONSERVATION):
    /// wealth = token.balanceOf(attacker) + previewRedeem(balanceOf(attacker)); profit = wealth − funded ≤ SLACK.
    /// Discriminator: on a vuln target profit ≫ SLACK (FAIL), on a correct one profit ≤ SLACK (PASS).
    /// Proof is quantitative — handler.maxProfitSeen() (logged in afterInvariant).
    function invariant_I2_attackerNoProfit() public view {
        address atk = handler.attacker();
        uint256 wealth = token.balanceOf(atk) + vault.previewRedeem(vault.balanceOf(atk));
        assertLe(wealth, handler.fundedAttacker() + SLACK, "I2: attacker profit > SLACK");
    }

    // ================= Control (always asserted): hold on a correct target =================

    /// I3 — conservation/solvency: sum of redeemable across holders ≤ totalAssets.
    function invariant_I3_solvency() public view {
        uint256 n = handler.holdersLength();
        uint256 sum;
        for (uint256 i; i < n; ++i) {
            sum += vault.previewRedeem(vault.balanceOf(handler.holders(i)));
        }
        assertLe(sum, vault.totalAssets(), "I3: sum redeemable > totalAssets");
    }

    /// I5 — withdrawing exactly maxWithdraw does not revert.
    function invariant_I5_maxWithdrawHonored() public view {
        assertFalse(handler.maxWithdrawReverted(), "I5: withdraw(maxWithdraw) revert");
    }

    /// I5b — redeeming exactly maxRedeem does not revert (redeem branch of the I5 class).
    function invariant_I5b_maxRedeemHonored() public view {
        assertFalse(handler.maxRedeemReverted(), "I5b: redeem(maxRedeem) revert");
    }

    /// I6 — the preview* rounding direction is not in the user's favor.
    function invariant_I6_previewRounding() public view {
        assertFalse(handler.previewMismatch(), "I6: preview rounding favors user");
    }

    // ================= Donation-class detector (always asserted): I7 =================

    /// I7 — a round-trip deposit→redeem does not return more than deposited beyond rounding dust.
    function invariant_I7_noRoundTripProfit() public view {
        assertLe(handler.maxRoundTripOvershoot(), SLACK, "I7: round-trip overshoot > SLACK");
    }

    // ================= Mechanism probes I1/I4 — OBSERVATIONAL (NOT asserted) =================

    /// afterInvariant — a forge-std hook, called after each invariant run. Logs the ghost probes
    /// and RESULT numbers. No assert is made: the target role (vuln/fix) is determined by the VERDICT of the gate/controls
    /// above, not by static knowledge. I1/I4 on a vuln target expectedly fire (log true), but do not fail the suite.
    function afterInvariant() public view {
        console2.log("PROBE I1 roundToZeroSeen:", handler.roundToZeroSeen());
        console2.log("PROBE I4 priceJumpSeen:", handler.priceJumpSeen());
        console2.log("RESULT maxProfitSeen:", handler.maxProfitSeen());
        console2.log("RESULT maxRoundTripOvershoot:", handler.maxRoundTripOvershoot());
        console2.log("RESULT maxSharePrice:", handler.maxSharePrice());
    }
}
